# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Auth.js（next-auth v5）=====
# production（Vercel / next start）必填，缺失会抛
#   AuthError: "There was a problem with the server configuration."
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 每个环境可用不同值；本地 .env.local 已有一份。勿提交真实值。
AUTH_SECRET=你的-auth-secret

# GitHub OAuth（可选，不配则登录页不显示 GitHub 按钮）
# 申请：https://github.com/settings/developers → New OAuth App
# Callback URL 填：<你的域名>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ===== Web → Worker 代理目标（vite/dev 代理或 Next 重写）=====
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
