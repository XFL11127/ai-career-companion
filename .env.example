# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Server-only: never expose this value through a NEXT_PUBLIC_ variable or browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Auth.js（next-auth v5）=====
# production（Vercel / next start）必填，缺失会抛
#   AuthError: "There was a problem with the server configuration."
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 每个环境可用不同值；本地 .env.local 已有一份。勿提交真实值。
AUTH_SECRET=你的-auth-secret

# GitHub OAuth（可选，不配则登录页不显示 GitHub 按钮）
# 申请：https://github.com/settings/developers → New OAuth App
# Callback URL 填：<你的域名>/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=

# ===== AI / internal embedding service =====
# Only the Next.js server reads these values. Never use a NEXT_PUBLIC_ prefix for the Worker secret.
DEEPSEEK_API_KEY=
WORKER_INTERNAL_URL=http://localhost:8787
WORKER_INTERNAL_SECRET=

# ===== 信息中枢 · 联网检索（可选）=====
# 博查 AI Web Search。未配置时信息中枢只展示「已核实证据库」，不返回任何示例/伪造结果。
BOCHA_API_KEY=
# 可选：覆盖检索端点（默认 https://api.bochaai.com/v1/web-search）
HUB_SEARCH_ENDPOINT=
# 可选：按需追加白名单域名，逗号分隔（如 api.icancareer.cn 之外的高校就业网）
HUB_WHITELIST_EXTRA=
# ===== 用户检索的成本护栏（重要）=====
# /api/hub/search 是唯一会按次扣博查余额的用户入口，以下三项控制花费：
# off       = 对用户关闭联网检索，只展示已核实库（运营侧用采集脚本更新）—— 最省钱
# limited   = 每 IP 每天限次 + 结果缓存（默认）
# unlimited = 不限次（不建议，会被刷爆）
HUB_USER_SEARCH=limited
# 每个 IP 每天允许的「真实 API 调用」次数（命中缓存不计数）
HUB_SEARCH_DAILY_LIMIT=3
# 相同检索词的结果缓存时长（小时）——缓存期内重复检索不产生新调用
HUB_SEARCH_CACHE_HOURS=24
