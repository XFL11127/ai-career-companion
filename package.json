{
  "name": "ai-career-companion",
  "version": "1.0.0",
  "description": "AI学职同伴 - 面向双非学生的AI Copilot式学职陪伴产品",
  "private": true,
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "test": "node --test",
    "dev": "turbo dev",
    "web": "npm --workspace @ai-career-companion/web run dev",
    "worker": "npm --workspace @ai-career-companion/worker run dev",
    "start": "npm run web",
    "build": "turbo build",
    "type-check": "turbo run type-check",
    "check": "npm run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/types",
    "packages/utils",
    "packages/llm"
  ],
  "type": "module",
  "packageManager": "npm@10.9.7",
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "turbo": "^2.10.5",
    "typescript": "^5.9.3"
  }
}
